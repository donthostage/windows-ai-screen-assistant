<Window x:Class="ScreenAssistant.Licensing.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Активация лицензии" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <Label Target="{Binding ElementName=ServerAddress}">Адрес сервера лицензий</Label>
        <TextBox x:Name="ServerAddress" MaxLength="512"/>
        <Label Target="{Binding ElementName=ActivationCode}">Код активации</Label>
        <PasswordBox x:Name="ActivationCode" MaxLength="64"/>
        <CheckBox x:Name="HardwareKey" Margin="0,10" IsChecked="True">Хранить ключ в TPM</CheckBox>
        <TextBlock x:Name="ActivationStatus" TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="ActivateButton" Content="Активировать" Click="Activate_Click"
                HorizontalAlignment="Left" Padding="12,5" IsDefault="True"/>
        <Button x:Name="BalanceButton" Content="Проверить баланс" Click="Balance_Click"
                HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0"/>
    </StackPanel>
</Window>

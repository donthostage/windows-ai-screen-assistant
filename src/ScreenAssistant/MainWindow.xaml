<Window x:Class="ScreenAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows AI Screen Assistant" Language="ru-RU"
        Width="1040" Height="760" MinWidth="700" MinHeight="530"
        Background="#F4F6F9" Foreground="#19253B" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#D8DFE8"/>
        <SolidColorBrush x:Key="Muted" Color="#4C5C73"/>
        <SolidColorBrush x:Key="Accent" Color="#224FAD"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="#19253B"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#193F91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#153375"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#E3E8F1"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D8DFE8"/>
                                <Setter Property="Foreground" Value="#4C5C73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#19253B"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16" LastChildFill="True">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,6"
                    CornerRadius="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="CaptureLight" Width="8" Height="8" Fill="#68778D" Margin="0,0,7,0"/>
                    <TextBlock x:Name="CaptureStatus" Text="Захват выключен" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <CheckBox x:Name="OverlayEnabled" DockPanel.Dock="Right" Content="Плавающий ответ"
                      VerticalAlignment="Center" Margin="8,0,12,0"
                      ToolTip="Показывает ответ поверх других окон."
                      Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
            <TextBlock Text="AI Screen Assistant" FontSize="27" FontWeight="SemiBold"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="13" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="ActivationPanel" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Section}" Text="1. Код активации"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                                       Text="Введите код, который вы получили. Адрес сервера задан в сборке."/>
                            <Label Target="{Binding ElementName=ActivationCode}">Код активации</Label>
                            <PasswordBox x:Name="ActivationCode" MaxLength="64" Margin="0,0,0,8"/>
                            <CheckBox x:Name="HardwareKey" Visibility="Collapsed" IsChecked="True" Margin="0,0,0,8"
                                      Content="Хранить ключ в TPM"/>
                            <Button x:Name="ActivateButton" Content="Активировать" Style="{StaticResource Primary}"
                                    Click="Activate_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ActivationStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel x:Name="LicenseReadyPanel" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Section}" Text="Доступ"/>
                            <TextBlock x:Name="LicenseReadyText" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BalanceButton" Content="Проверить доступ" Click="Balance_Click" Margin="0,0,8,0"/>
                                <Button Content="Другой код" Click="ShowActivation_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="2. Источник"/>
                        <TextBlock x:Name="SourceText" Text="Источник ещё не выбран." TextWrapping="Wrap"
                                   FontWeight="SemiBold" Margin="0,5,0,4"/>
                        <TextBlock x:Name="NextStepText" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Нажмите «Выбрать…», укажите окно Chrome и подтвердите ОК."/>
                        <Button x:Name="PickButton" Content="Выбрать…" Click="Pick_Click" HorizontalAlignment="Left"
                                MinWidth="140" Margin="0,0,0,10"/>
                        <Label Target="{Binding ElementName=PeriodicInterval}" Content="Интервал анализа, с"/>
                        <TextBox x:Name="PeriodicInterval" Text="30" Margin="0,0,0,8"
                                 PreviewTextInput="PeriodicInterval_PreviewTextInput"
                                 LostFocus="PeriodicInterval_LostFocus"/>
                        <Button x:Name="BorderlessButton" Content="Запросить захват без рамки"
                                Click="Borderless_Click" Margin="0,0,0,10" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsEnabled, ElementName=PickButton}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Анализируется всё выбранное окно. Для длинной страницы нажмите Ctrl+Alt+L. Перед отправкой нужно подтвердить передачу кадров."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5*" MinHeight="88"/>
                        <RowDefinition Height="7*" MinHeight="140"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="FrameDetails" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Section}" Text="Предпросмотр"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#EEF2F7" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="5" Padding="5" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PreviewEmpty" Style="{StaticResource Hint}" Text="Кадр ещё не получен"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   AutomationProperties.Name="Последний захваченный кадр"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="2" Margin="0,13,0,0" BorderBrush="{StaticResource Line}">
                        <TabItem x:Name="AnswerTab" Header="Последний ответ">
                            <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="AnswerText" Text="Ответ появится после первого анализа."
                                           Margin="10" TextWrapping="Wrap" AutomationProperties.Name="Последний ответ модели"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="История">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="48"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Hint}"
                                           Text="В этой сессии пока нет ответов." Margin="5" IsHitTestVisible="False"
                                           Panel.ZIndex="1"/>
                                <ListBox x:Name="HistoryList" DisplayMemberPath="Label" SelectionChanged="History_Changed"
                                         AutomationProperties.Name="История ответов"/>
                                <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="HistoryText" Margin="5" TextWrapping="Wrap"
                                               AutomationProperties.Name="Выбранный ответ из истории"/>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Оверлей">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="OverlayOptions" Margin="10">
                                    <Grid.Resources>
                                        <Style x:Key="Value" TargetType="TextBlock">
                                            <Setter Property="Margin" Value="7,0,0,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                        <Style x:Key="CompactHeightStyle" TargetType="FrameworkElement">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Compact}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="DetailedHeightStyle" TargetType="FrameworkElement">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Compact}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="31"/>
                                        <RowDefinition Height="31"/>
                                        <RowDefinition Height="31"/>
                                        <RowDefinition Height="31"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.ColumnSpan="3" Content="Компактная строка" IsChecked="{Binding Compact}"
                                              VerticalAlignment="Center"/>

                                    <Label Grid.Row="1" Target="{Binding ElementName=OverlayWidth}" Content="Ширина"
                                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <Slider x:Name="OverlayWidth" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="2400"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Width}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Width, StringFormat=F0}"/>

                                    <TextBlock Grid.Row="2" Text="Высота" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,9,0"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="144" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding CompactHeight}"
                                            Style="{StaticResource CompactHeightStyle}" AutomationProperties.Name="Высота компактной строки"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="1400" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding Height}"
                                            Style="{StaticResource DetailedHeightStyle}" AutomationProperties.Name="Высота многострочного окна"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding DisplayHeight, StringFormat=F0}"/>

                                    <Label Grid.Row="3" Target="{Binding ElementName=OverlayFont}" Content="Размер шрифта"
                                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <Slider x:Name="OverlayFont" Grid.Row="3" Grid.Column="1" Minimum="12" Maximum="26"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding FontSize, StringFormat=F0}"/>

                                    <Label Grid.Row="4" Target="{Binding ElementName=OverlayOpacity}" Content="Непрозрачность фона"
                                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <Slider x:Name="OverlayOpacity" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1"
                                            TickFrequency=".01" IsSnapToTickEnabled="True" Value="{Binding PanelOpacity}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding PanelOpacity, StringFormat=P0}"/>

                                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,7,0,0">
                                        <CheckBox Content="Скрывать оверлей из записи экрана"
                                                  IsChecked="{Binding ExcludeFromCapture}" Margin="0,0,0,6"
                                                  ToolTip="Просьба к Windows не включать это окно в запись. Кадр всё равно может его содержать."/>
                                        <CheckBox Content="Плотный фон — так текст читается лучше"
                                                  IsChecked="{Binding SolidBackground}" Margin="0,0,0,6"
                                                  ToolTip="Сплошная заливка без просвечивания. Включите, если ответ сливается со страницей."/>
                                        <Button HorizontalAlignment="Left" Content="Сбросить положение"
                                                Click="ResetOverlayPosition_Click"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Плотный фон — настройка читаемости. Он не скрывает оверлей от захвата экрана. Эти ползунки остаются в этом окне, даже если плавающий ответ растянут на весь экран."/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="9" Padding="12,9" Margin="0,13,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="StartCue" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold" Foreground="#224FAD" Text="Следующий шаг"/>
                    <Button x:Name="StartPeriodicButton" Content="_Запустить анализ" Style="{StaticResource Primary}" Click="StartPeriodic_Click"
                            MinWidth="180" Margin="0,0,6,0"/>
                    <Button x:Name="StopButton" Content="_Остановить" Click="Stop_Click" MinWidth="106"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Готово к настройке" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="StatsText" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Трей у часов. Крестик — в трей. Выход — из меню иконки. Хоткеи: Ctrl+Alt+M окно · Ctrl+Alt+H оверлей · Ctrl+Alt+L длинная страница · Ctrl+Alt+J/K прокрутка · Ctrl+Alt+U автопрокрутка · Ctrl+Alt+Пробел остановка"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

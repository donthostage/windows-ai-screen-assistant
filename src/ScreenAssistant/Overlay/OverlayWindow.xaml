<Window x:Class="ScreenAssistant.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant — ответы" Language="ru-RU"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="#F4F7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </Window.Resources>
    <Grid>
        <Border Background="#282828" Opacity="{Binding PanelOpacity}"
                CornerRadius="7" IsHitTestVisible="False"/>

        <Grid Margin="9,5,8,5">
            <Border Background="{Binding HeaderBackground}" Cursor="SizeAll"
                    Visibility="{Binding Compact, Converter={StaticResource VisibleWhenTrue}}"
                    MouseLeftButtonDown="DragHeader" ToolTip="{Binding CompactText}">
                <TextBlock x:Name="CompactAnswer" Margin="{Binding TextInset}" Text="{Binding CompactText}" FontSize="{Binding CompactFontSize}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Плавающий ответ" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F4F7FF"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#070F1C" BlurRadius="3" ShadowDepth="1" Opacity="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#FFD0C5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Compact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{Binding HeaderBackground}" Cursor="SizeAll" MouseLeftButtonDown="DragHeader"
                        Padding="0,5" ToolTip="Перетащите, чтобы переместить окно">
                    <TextBlock Margin="{Binding TextInset}" Text="{Binding Status}" Foreground="#D7E4F8" TextWrapping="Wrap"
                               FontSize="13" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <ScrollViewer x:Name="Answer" Grid.Row="1" Margin="{Binding TextInset}"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#F4F7FF"
                               Margin="0,2" TextWrapping="Wrap" AutomationProperties.Name="Полный плавающий ответ"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
